AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=KSAE 공지봇
ADMIN_EMAIL=
SITE_URL=http://localhost:3000
DATABASE_PATH=./data/ksae.db

# NicePay (결제창 서버승인). clientId 는 브라우저로 나가는 공개값이고
# secretKey 는 서버 전용이다 — 이 저장소는 public 이므로 커밋하지 말 것.
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
# 운영 https://api.nicepay.co.kr / 샌드박스 https://sandbox-api.nicepay.co.kr
NICEPAY_API_BASE=https://api.nicepay.co.kr

# 심사용 ID/PW 로그인 (/review-login). 나이스페이·카드사 심사가 "SNS 로그인 불가"
# 계정을 요구할 때만 채운다. 둘 다 있어야 켜지고, 비워두면 그 경로는 404 다.
# REVIEW_LOGIN_ID=
# REVIEW_LOGIN_PASSWORD=
